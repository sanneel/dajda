# ---------------------------------------------------------------------------
# DAJDA - example environment. Copy to `.env` and fill in.
# NEVER commit a real .env. No credential in this file is a working secret.
#
# The values below are development defaults. With NODE_ENV=production the app
# REFUSES TO START on any of them - see the guard in src/lib/env.ts. Each one
# fails silently otherwise: a mock provider hands out free subscriptions, the
# published mock secret lets anyone forge a webhook, and an http:// APP_URL
# drops the Secure flag from the session cookie.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# The bundled docker-compose.yml serves exactly this URL.
DATABASE_URL="postgresql://dajda:dajda@localhost:5432/dajda?schema=public"

# Secret used to sign session and CSRF tokens.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Absolute public origin, used for cookie scoping, payment return URLs and the
# Origin check that backs CSRF protection.
# Production: must be your real https:// origin.
APP_URL="http://localhost:3000"

# Which payment adapter to load: "mock" (development) or "flitt" (production).
# "mock" also enables /dev/checkout and the payment simulator, so production
# rejects it.
PAYMENT_PROVIDER="mock"

# Signing secret for the development mock provider's simulated webhooks.
# Only used when PAYMENT_PROVIDER=mock. The literal "dev-mock-secret" is
# rejected in production because it is published here.
MOCK_PAYMENT_SECRET="dev-mock-secret-not-for-production"

# --- Flitt (https://docs.flitt.com) -----------------------------------------
# Required only when PAYMENT_PROVIDER=flitt.
FLITT_MERCHANT_ID=
FLITT_SECRET_KEY=
FLITT_WEBHOOK_SECRET=
FLITT_API_URL="https://pay.flitt.com"
